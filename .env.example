# 仅通过环境变量注入；本项目不会自动加载 dotenv。
# 切勿把真实密钥写入本文件或提交到版本库。

# --- 必需（调用 verify_smtp_connection / send_email 时）---
SMTP_USER=your-name@your-company.com
SMTP_PASSWORD=your-smtp-auth-password

# --- SMTP（可选，有安全默认值）---
# 默认阿里云企业邮：隐式 TLS 465 + 校验证书
SMTP_HOST=smtp.qiye.aliyun.com
SMTP_PORT=465
# 传输模式：implicit（默认，465）或 starttls（如 587，requireTLS，仍校验证书）
SMTP_TLS_MODE=implicit

# --- 收件人白名单（默认失败关闭）---
# 逗号分隔的明文邮箱；所有 to/cc/bcc 必须命中。未配置则拒绝发送。
MAIL_RECIPIENT_ALLOWLIST=you@your-company.com,ops@your-company.com

# --- 生产外发显式选择加入（不是用户审批的替代品）---
# 仅当 NODE_ENV=production 时需要设为 true，否则生产环境拒绝发送。
# 开发环境只需白名单即可（仍须宿主先展示完整草稿并获人类明确批准）。
MAIL_PRODUCTION_SEND_OPT_IN=false

# --- 签名（可选）---
# 每次 send_email 自动附在正文末尾。图片必须是可公开访问的 https 地址。
# 正文里已经包含同一段签名或同一图片地址时不会重复追加。
# 本程序不会自动加载本文件，需由启动进程的环境注入。
# MAIL_SIGNATURE_HTML=<p><img src='https://example.com/logo.png' alt='Logo' width='280'></p>
# MAIL_SIGNATURE_TEXT="Best Regards\nYour Name"

# --- 附件（可选）---
# 仅允许读取该根目录下的常规本地文件（经 realpath 约束，禁止符号链接逃逸）
MAIL_ATTACHMENT_ROOT=/absolute/path/to/allowed/attachments

# --- 超时（毫秒，可选）---
SMTP_CONNECTION_TIMEOUT_MS=15000
SMTP_GREETING_TIMEOUT_MS=15000
SMTP_SOCKET_TIMEOUT_MS=60000
SMTP_SEND_TIMEOUT_MS=60000
